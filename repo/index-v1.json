0\u0435\u043d\u0438\u044f\u0442\u0430 \u0441\u0438 \u043f\u0440\u0438 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0430\u0442\u0430 \u0438\u043b\u0438 \u0434\u043e\u043a\u043e\u0441\u043d\u0435\u0442\u0435 \u201e\u0412\u0441\u0438\u0447\u043a\u0438\u201c.\n\u2022 \u0415\u043a\u0440\u0430\u043d \u0437\u0430 \u0442\u0435\u0441\u0442\u0435\u0442\u043e \u0441 \u0435\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u0438: \u0438\u0437\u0431\u0435\u0440\u0435\u0442\u0435 \u0441\u043b\u0435\u0434\u0432\u0430\u0449\u0430\u0442\u0430 \u0435\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u044f, \u043f\u0440\u0435\u043c\u0430\u0445\u043d\u0435\u0442\u0435 \u043a\u0430\u0440\u0442\u0438\u0442\u0435 \u043d\u0430 \u043b\u043e\u043a\u0430\u0446\u0438\u044f \u0438\u043b\u0438 \u0433\u0438 \u0432\u044a\u0440\u043d\u0435\u0442\u0435.\n\u2022 \u0415\u043a\u0440\u0430\u043d \u0441 \u0438\u0437\u0445\u0432\u044a\u0440\u043b\u0435\u043d\u0438\u0442\u0435 \u043a\u0430\u0440\u0442\u0438: \u043f\u0440\u0435\u0433\u043b\u0435\u0434\u0430\u0439\u0442\u0435 \u0438 \u043f\u0440\u0435\u043c\u0430\u0445\u043d\u0435\u0442\u0435 \u043a\u0430\u0440\u0442\u0438\u0442\u0435 \u043e\u0442 \u0442\u0435\u043a\u0443\u0449\u0430\u0442\u0430 \u0438\u0433\u0440\u0430.\n\n\u0421\u042a\u0417\u0414\u0410\u0414\u0415\u041d\u041e \u0417\u0410 \u041c\u0410\u0421\u0410\u0422\u0410\n\u2022 \u0422\u044a\u043c\u0435\u043d \u0434\u0438\u0437\u0430\u0439\u043d \u201e\u043d\u043e\u0449\u043d\u043e \u043d\u0435\u0431\u0435\u201c, \u0443\u0434\u043e\u0431\u0435\u043d \u043f\u0440\u0438 \u0441\u043b\u0430\u0431\u0430 \u0441\u0432\u0435\u0442\u043b\u0438\u043d\u0430.\n\u2022 \u0413\u043e\u043b\u044f\u043c\u0430 \u043a\u0430\u0440\u0442\u0430 \u0432\u044a\u0440\u0445\u0443 \u043f\u0435\u0440\u0433\u0430\u043c\u0435\u043d\u0442 \u0441 \u0442\u0440\u0438\u0442\u0435 \u043b\u043e\u043a\u0430\u0446\u0438\u0438 \u043d\u0430 \u0432\u0441\u0435\u043a\u0438 \u0440\u0435\u0433\u0438\u043e\u043d.\n\u2022 \u041e\u0442\u0434\u0