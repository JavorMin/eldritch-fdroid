41e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u043a\u043e\u043b\u043e\u0434\u044b \u0432 \u043a\u043e\u0440\u043e\u0431\u043a\u0435. Eldritch RU \u0440\u0430\u0437\u0434\u0430\u0451\u0442 \u043a\u0430\u0440\u0442\u044b \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043e\u0432, \u043b\u043e\u043a\u0430\u0446\u0438\u0439 \u0438 \u044d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u0439 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u043e\u0439 \u0438\u0433\u0440\u044b \u00ab\u0414\u0440\u0435\u0432\u043d\u0438\u0439 \u0443\u0436\u0430\u0441\u00bb (Eldritch Horror) \u043f\u0440\u044f\u043c\u043e \u043d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0435 \u0438\u043b\u0438 \u043f\u043b\u0430\u043d\u0448\u0435\u0442\u0435.\n\n\u041f\u041e\u041b\u041d\u041e\u0421\u0422\u042c\u042e \u041d\u0410 \u0420\u0423\u0421\u0421\u041a\u041e\u041c\n\u2022 \u0412\u0441\u0435 \u043a\u0430\u0440\u0442\u044b \u0438 \u0432\u0435\u0441\u044c \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441 \u043d\u0430 \u0440\u0443\u0441\u0441\u043a\u043e\u043c \u044f\u0437\u044b\u043a\u0435.\n\u2022 \u0413\u043b\u043e\u0441\u0441\u0430\u0440\u0438\u0439: \u043e\u0434\u043d\u043e \u043a\u0430\u0441\u0430\u043d\u0438\u0435 \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0435\u0442 \u0432\u0441\u0435 \u0442\u0435\u0440\u043c\u0438\u043d\u044b \u0432 \u0441\u043a\u043e\u0431\u043a\u0430\u0445 \u043d\u0430 \u0442\u0435\u043a\u0443\u0449\u0435\u0439 \u043a\u0430\u0440\u0442\u0435.\n\u2022 \u041d\u0443\u0436\u043d\u044b \u0440\u0443\u0441\u0441\u043a\u0438\u0439, \u0431\u043e\u043b\u0433\u0430\u0440\u0441\u043a\u0438\u0439 \u0438 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438\u0439 \u0432 \u043e\u0434\u043d\u043e\u043c \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438? \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 Eldritch Companion EN RU BG \u0438\u0437 \u044d\u0442\u043e\u0433\u043e \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u044f.\n\n\u0412\u0421\u0415 \u041a\u041e\u041b\u041e\u0414\u042b\n\u2022 \u0410\u043c\u0435\u0440\u0438\u043a\u0430, \u0415\u0432\u0440\u043e\u043f\u0430, \u0410\u0437\u0438\u044f/\u0410\u0432\u0441\u0442\u0440\u0430\u043b\u0438\u044f, \u041e\u0431\u0449\u0438\u0435 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u044b, \u0412\u0440\u0430\u0442\u0430, \u042d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u0438, \u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f, \u0422\u0430\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0440\u0443\u0438\u043d\u044b, \u041f\u043e\u0438\u0441\u043a\u0438 \u0441\u043d\u043e\u0432, \u0411\u0435\u0434\u0441\u0442\u0432\u0438\u044f, \u041e\u043f\u0443\u0441\u0442\u043e\u0448\u0435\u043d\u0438\u044f \u0438 \u043a\u043e\u043b\u043e\u0434\u044b \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0439.\n\u2022 \u0410\u043d\u0442\u0430\u0440\u043a\u0442\u0438\u0434\u0430, \u0415\u0433\u0438\u043f\u0435\u0442, \u0421\u0442\u0440\u0430\u043d\u0430 \u0441\u043d\u043e\u0432 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435: \u043e\u0442\u043c\u0435\u0442\u044c\u0442\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u043f\u0440\u0438 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0435 \u0438\u043b\u0438 \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \u00ab\u0412\u0441\u0435\u00bb.\n\u2022 \u042d\u043a\u0440\u0430\u043d \u043a\u043e\u043b\u043e\u0434\u044b \u044d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u0439: \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0443\u044e \u044d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u044e, \u0443\u0431\u0435\u0440\u0438\u0442\u0435 \u043a\u0430\u0440\u0442\u044b \u043b\u043e\u043a\u0430\u0446\u0438\u0438 \u0438\u043b\u0438 \u0432\u0435\u0440\u043d\u0438\u0442\u0435 \u0438\u0445.\n\u2022 \u042d\u043a\u0440\u0430\u043d \u0441\u0431\u0440\u043e\u0441\u0430: \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u0438 \u0443\u0431\u0435\u0440\u0438\u0442\u0435 \u043a\u0430\u0440\u0442\u044b \u0442\u0435\u043a\u0443\u0449\u0435\u0439 \u043f\u0430\u0440\u0442\u0438\u0438.\n\n\u0421\u041e\u0417\u0414\u0410\u041d\u041e \u0414\u041b\u042f \u0418\u0413\u0420\u041e\u0412\u041e\u0413\u041e \u0421\u0422\u041e\u041b\u0410\n\u2022 \u0422\u0451\u043c\u043d\u044b\u0439 \u0434\u0438\u0437\u0430\u0439\u043d \u00ab\u043d\u043e\u0447\u043d\u043e\u0435 \u043d\u0435\u0431\u043e\u00bb, \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u044b\u0439 \u043f\u0440\u0438 \u043f\u0440\u0438\u0433\u043b\u0443\u0448\u0451\u043d\u043d\u043e\u043c \u0441\u0432\u0435\u0442\u0435.\n\u2022 \u041a\u0440\u0443\u043f\u043d\u0430\u044f \u043a\u0430\u0440\u0442\u0430 \u043d\u0430 \u043f\u0435\u0440\u0433\u0430\u043c\u0435\u043d\u0442\u0435 \u0441 \u0442\u0440\u0435\u043c\u044f \u043b\u043e\u043a\u0430\u0446\u0438\u044f\u043c\u0438 \u0440\u0435\u0433\u0438\u043e\u043d\u0430.\n\u2022 \u041e\u0442\u0434\u0435\u043b\u044c\u043d\u0430\u044f \u0440\u0430\u0441\u043a\u043b\u0430\u0434\u043a\u0430 \u0434\u043b\u044f \u043f\u043b\u0430\u043d\u0448\u0435\u0442\u043e\u0432, \u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u0430\u044f \u0438 \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u044f.\n\u2022 \u041f\u0430\u0440\u0442\u0438\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f \u043d\u0430 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0435 \u2014 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435 \u0441 \u0442\u043e\u0433\u043e \u0436\u0435 \u043c\u0435\u0441\u0442\u0430.\n\n\u041a\u041e\u041d\u0424\u0418\u0414\u0415\u041d\u0426\u0418\u0410\u041b\u042c\u041d\u041e\u0421\u0422\u042c\n\u2022 \u0411\u0435\u0437 \u0440\u0435\u043a\u043b\u0430\u043c\u044b. \u0411\u0435\u0437 \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u0430. \u0411\u0435\u0437 \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u0432 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442. \u041f\